# Sucremi 本地开发环境变量示例。
# 用法：复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）。
# 本文件只包含占位值，禁止写入真实密码或密钥。
#
# 后端通过环境变量读取这些配置（见 apps/server/src/main/resources/application.yaml）。
# 可在 shell 中 export，或在 IDE 运行配置中设置。

# ---- 数据库（MySQL 8.4 LTS，本地开发）----
SUCREMI_DB_URL=jdbc:mysql://localhost:3306/sucremi?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
SUCREMI_DB_USERNAME=sucremi
SUCREMI_DB_PASSWORD=change-me-local-password

# ---- 后端服务端口 ----
SUCREMI_SERVER_PORT=8080
